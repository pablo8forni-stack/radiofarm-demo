rules_version = '2';

// Asume que roles/{email} usa siempre el email en minúsculas (así lo escribe
// services/auth.js#setRol) y que request.auth.token.email también viene en
// minúsculas (así lo devuelve Google para cuentas Gmail/Workspace estándar).
service cloud.firestore {
  match /databases/{database}/documents {

    function tieneAcceso() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/roles/$(request.auth.token.email));
    }

    function miRol() {
      return get(/databases/$(database)/documents/roles/$(request.auth.token.email)).data;
    }

    function isAdmin() {
      return request.auth != null && tieneAcceso() && miRol().rol == 'admin';
    }

    // Permiso aparte del rol técnico/admin -- admin siempre puede cargar
    // Dosis terapéutica de I-131 (no necesita el flag); esto sólo amplía el
    // permiso a un técnico puntual, asignado desde Configuración > Usuarios.
    function tieneAccesoI131() {
      return isAdmin() || miRol().accesoTerapiaI131 == true;
    }

    // roles: cada quien lee su propio doc; sólo admins leen/escriben todo.
    match /roles/{email} {
      allow read: if request.auth != null && (request.auth.token.email == email || isAdmin());
      allow write: if isAdmin();
    }

    // solicitudes: cualquier autenticado puede crear/leer la propia (para pedir
    // acceso); sólo un admin lee todas y las borra (al aprobar o rechazar).
    // No hay update: aprobar = crear roles/{email} + borrar la solicitud.
    match /solicitudes/{email} {
      allow create: if request.auth != null &&
                       request.auth.token.email == email &&
                       request.auth.token.email == request.resource.data.email;
      allow read: if request.auth != null && (request.auth.token.email == email || isAdmin());
      allow delete: if isAdmin();
      allow update: if false;
    }

    // Catálogo y proveedores: lectura para cualquier usuario con acceso, escritura sólo admin.
    match /farms/{farmId} {
      allow read: if tieneAcceso();
      allow write: if isAdmin();
    }
    match /proveedores/{provId} {
      allow read: if tieneAcceso();
      allow write: if isAdmin();
    }
    // Sólo controla qué nombres aparecen en los selectores de isótopo (Libro
    // 2, Terapia I-131) -- ver comentario largo en services/firestore/
    // radioisotopos.js. El comportamiento especial de cada uno sigue atado al
    // id fijo en el código, no a nada de esta colección.
    match /radioisotopos/{isotopoId} {
      allow read: if tieneAcceso();
      allow write: if isAdmin();
    }
    // Lista dinámica de estudios del selector de Libro 2 -- a diferencia de
    // radioisotopos, el id acá no tiene ningún significado especial (el acta
    // guarda el nombre elegido, no el id).
    match /estudios/{estudioId} {
      allow read: if tieneAcceso();
      allow write: if isAdmin();
    }

    // sedes: config (activo/farmIds/puntosReorden) sólo la edita un admin.
    match /sedes/{sedeId} {
      allow read: if tieneAcceso();
      allow write: if isAdmin();

      // lotes: técnico de esa sede puede actualizar, pero SÓLO vía egreso --
      // el único cambio que un egreso hace es restar de `cantidad`, ningún
      // otro campo. Sin esto, un técnico con su propia sesión (SDK/consola,
      // sin pasar por la UI) podría subir `cantidad` (crear stock de la
      // nada, sin movimiento que lo respalde) o cambiar lote/vencimiento/
      // farmId de un lote existente. Admin queda sin esta restricción:
      // anulación (puede subir cantidad) y acreditación de transferencia
      // (crea/actualiza el lote destino) son siempre admin, cubiertas por
      // el primer `isAdmin()` del OR. Crear/borrar lotes (ingreso, alta de
      // transferencia) sigue siendo sólo admin, igual que en la UI.
      match /lotes/{loteId} {
        allow read: if tieneAcceso();
        allow update: if isAdmin() || (
          miRol().rol == 'tecnico' && miRol().sede == sedeId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cantidad']) &&
          request.resource.data.cantidad is number &&
          request.resource.data.cantidad >= 0 &&
          request.resource.data.cantidad < resource.data.cantidad
        );
        allow create, delete: if isAdmin();
      }
    }

    // La regla anidada de arriba sólo cubre lecturas/escrituras cuando se
    // conoce la sede de antemano (getDocs(collection(db,'sedes',id,'lotes'))).
    // CatalogoContext escucha TODAS las sedes con un solo
    // collectionGroup('lotes') (ver services/firestore/stock.js#listenLotes),
    // y Firestore exige una regla aparte con el wildcard recursivo {path=**}
    // para autorizar ese tipo de consulta -- si no está, el listener falla
    // con permission-denied aunque la regla anidada de arriba sea correcta.
    match /{path=**}/lotes/{loteId} {
      allow read: if tieneAcceso();
    }

    // movimientos y actas: inmutables por diseño (requisito 8) -- create-only,
    // nunca update/delete. La "anulación" es siempre un movimiento nuevo.

    function tiposMovimiento() {
      return ['ingreso', 'egreso', 'transferencia_salida', 'transferencia_entrada', 'anulacion'];
    }

    // Valida contenido, no sólo permiso de escribir. Técnico sólo puede crear
    // 'egreso' (nunca ingreso, transferencia ni anulación) y siempre sobre su
    // propia sede; admin no tiene esa restricción de tipo/sede.
    function movimientoValido() {
      let d = request.resource.data;
      return d.usuarioEmail == request.auth.token.email &&
        d.tipo in tiposMovimiento() &&
        d.cantidad is number && d.cantidad > 0 &&
        d.sedeId is string && d.sedeId.size() > 0 &&
        d.farmId is string && d.farmId.size() > 0 &&
        d.lote is string && d.lote.size() > 0 &&
        (isAdmin() || miRol().sede == d.sedeId) &&
        (d.tipo == 'egreso' || isAdmin()) &&
        (!(d.tipo == 'ingreso' || d.tipo == 'egreso') || (d.loteId is string && d.loteId.size() > 0)) &&
        (!(d.tipo == 'transferencia_salida' || d.tipo == 'transferencia_entrada') ||
          (d.grupoId is string && d.grupoId.size() > 0 && d.sedeRelacionada is string)) &&
        (d.tipo != 'anulacion' || (d.anulaId is string && d.anulaId.size() > 0));
    }

    match /movimientos/{movId} {
      allow read: if tieneAcceso();
      allow create: if tieneAcceso() && movimientoValido();
      allow update, delete: if false;
    }

    function tiposActa() {
      return ['paciente', 'marcacion', 'elucion', 'anulacion', 'i131_dosis', 'i131_barrido'];
    }

    // Elución (Libro 3, Mo-99/Tc-99m): la actividad calibrada del generador
    // sólo se carga en la primera elución de cada lote/serie -- generadoresVistos
    // (ver match más abajo) guarda un marcador con id determinístico
    // sedeId+'_'+loteGenerador (mayúsculas), creado junto con esa primera
    // acta. Mientras no exista el marcador, actividadCalibrada es
    // obligatoria; si ya existe, no se vuelve a pedir. Esto cierra del lado
    // servidor lo mismo que ya detecta el cliente para mostrar/ocultar el
    // campo -- sin esto, alguien saltándose la UI podría omitir un dato
    // regulatorio que no se puede recuperar después.
    // .upper(): el id no puede depender de la capitalización con la que cada
    // quien tipeó el lote (mismo criterio que normalizarLoteGenerador en
    // services/firestore/actas.js -- "Gen2026014" y "gen2026014" tienen que
    // resolver al mismo marcador). El cliente ya garantiza el valor recortado
    // (.trim()) antes de llegar acá, sólo hace falta normalizar mayúsculas.
    function loteGeneradorVisto(sedeId, lote) {
      return exists(/databases/$(database)/documents/generadoresVistos/$(sedeId + '_' + lote.upper()));
    }

    // Sede, tipo, farmId/lote no vacíos (el formulario ya los exige del lado
    // cliente desde que se cerró el hallazgo #5; esto lo respalda del lado
    // servidor) y que la dosis declarada sea > 0. 'anulacion' es su propio
    // caso: sólo admin (mismo criterio que movimientos), sin farmId/lote/dosis
    // -- exige en cambio anulaId, el id del acta original que corrige. Las
    // actas siguen create-only (ver match de abajo): anular es SIEMPRE un
    // acta nueva vinculada por anulaId, nunca una edición de la original --
    // mismo espíritu de inmutabilidad que ya usa `movimientos`.
    //
    // 'i131_dosis'/'i131_barrido' (Terapia I-131, pestaña propia): dos tipos
    // planos, mismo criterio que transferencia_salida/transferencia_entrada
    // en movimientos, no un campo "subtipo". 'i131_dosis' exige
    // tieneAccesoI131() -- admin o técnico con el flag; 'i131_barrido' no,
    // cualquier técnico de la sede puede cargarlo. Ninguno de los dos usa
    // farmId/stock: el lote de la dosis/cápsula es texto libre, igual que
    // loteGenerador en elución (no son radiofármacos con stock rotativo).
    //
    // 'paciente' (Libro 2) ahora siempre trae isotopoId ('tc99m' por
    // defecto, nunca ausente en actas nuevas -- las viejas sin el campo
    // siguen leyéndose igual, el cliente las trata como tc99m). Con
    // isotopoId=='lu177' (Teragnosis) el lote también es texto libre y en
    // cambio exige medicoResponsable; con cualquier otro valor (tc99m, el
    // caso de siempre) sigue exigiendo farmId como hasta ahora.
    function actaValida() {
      let d = request.resource.data;
      return d.usuarioEmail == request.auth.token.email &&
        d.tipo in tiposActa() &&
        d.sedeId is string && d.sedeId.size() > 0 &&
        (isAdmin() || miRol().sede == d.sedeId) &&
        (d.tipo == 'anulacion'
          ? (isAdmin() && d.anulaId is string && d.anulaId.size() > 0)
          : d.tipo == 'elucion'
            ? (d.loteGenerador is string && d.loteGenerador.size() > 0 &&
               d.actividadEluida is number && d.actividadEluida > 0 &&
               d.volumen is number && d.volumen > 0 &&
               (loteGeneradorVisto(d.sedeId, d.loteGenerador) ||
                 (d.actividadCalibrada is number && d.actividadCalibrada > 0)))
            : d.tipo == 'i131_dosis'
              ? (tieneAccesoI131() &&
                 d.pacienteFicha is string && d.pacienteFicha.size() > 0 &&
                 d.pacienteNombre is string && d.pacienteNombre.size() > 0 &&
                 d.pacienteDni is string && d.pacienteDni.size() > 0 &&
                 d.medicoResponsable is string && d.medicoResponsable.size() > 0 &&
                 d.actividadAdministrada is number && d.actividadAdministrada > 0 &&
                 d.lote is string && d.lote.size() > 0)
              : d.tipo == 'i131_barrido'
                ? (d.pacienteFicha is string && d.pacienteFicha.size() > 0 &&
                   d.pacienteNombre is string && d.pacienteNombre.size() > 0 &&
                   d.pacienteDni is string && d.pacienteDni.size() > 0 &&
                   d.medicoResponsable is string && d.medicoResponsable.size() > 0)
                : (d.lote is string && d.lote.size() > 0 &&
                   (d.tipo == 'paciente'
                     ? (d.mciAdministrados is number && d.mciAdministrados > 0 &&
                        d.pacienteFicha is string && d.pacienteFicha.size() > 0 &&
                        d.isotopoId is string && d.isotopoId.size() > 0 &&
                        (d.isotopoId != 'lu177'
                          ? (d.farmId is string && d.farmId.size() > 0)
                          : (d.medicoResponsable is string && d.medicoResponsable.size() > 0)))
                     : (d.farmId is string && d.farmId.size() > 0 &&
                        d.mciMarcacion is number && d.mciMarcacion > 0))));
    }

    // Las actas tienen nombre y DNI de pacientes (Libro 2) -- Ley 25.326.
    // Un técnico sólo puede leer las de su propia sede; admin lee todas.
    // El cliente tiene que reflejar esto en la query (ver listenActas /
    // actasPorRango): las reglas no filtran resultados, rechazan la consulta
    // entera si pide más de lo que el técnico puede leer -- por eso un
    // listener sin where(sedeId==) para un técnico rompería con
    // permission-denied en vez de traer sólo lo permitido.
    match /actas/{actaId} {
      allow read: if isAdmin() || (tieneAcceso() && miRol().sede == resource.data.sedeId);
      allow create: if tieneAcceso() && actaValida();
      allow update, delete: if false;
    }

    // Marcador de "primera elución de este lote/serie" -- ver
    // loteGeneradorVisto arriba. No tiene datos de pacientes, no necesita la
    // restricción de lectura por sede que sí tiene actas.
    function generadorValido() {
      let d = request.resource.data;
      return d.sedeId is string && d.sedeId.size() > 0 &&
        d.loteGenerador is string && d.loteGenerador.size() > 0 &&
        (isAdmin() || miRol().sede == d.sedeId);
    }

    match /generadoresVistos/{id} {
      allow read: if tieneAcceso();
      allow create: if tieneAcceso() && generadorValido();
      allow update, delete: if false;
    }

    function tiposAuditoria() {
      return ['restauracion_backup'];
    }

    // Trazabilidad de acciones administrativas (hoy sólo restaurar backup)
    // separada de `movimientos` -- esa colección es movimiento físico de
    // viales, no acciones de configuración. Sólo un admin la lee o la crea
    // (misma gente que puede ejecutar la acción que se está auditando);
    // inmutable, igual que movimientos/actas.
    function auditoriaValida() {
      let d = request.resource.data;
      return d.usuarioEmail == request.auth.token.email && d.tipo in tiposAuditoria();
    }

    match /auditoria/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && auditoriaValida();
      allow update, delete: if false;
    }
  }
}
